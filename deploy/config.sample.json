{
  "ollama_base_url": "http://192.168.111.62:11434",
  "ollama_chat_model": "gemma4:26b",
  "fast_model": "gemma4:26b",
  "voice_collect_seconds": 1.5,
  "whisper_model": "medium",
  "whisper_device": "cuda",
  "whisper_compute_type": "int8",
  "dictation_enabled": false,
  "location_enabled": false,
  "planner_enabled": false,
  "transcript_buffer_duration_sec": 30.0,
  "tts_piper_model_path": "/data/.local/share/jarvis/models/piper/jarvis-medium.onnx",
  "tts_piper_length_scale": 1.0,
  "tts_piper_noise_scale": 0.667,
  "tts_piper_noise_w": 0.8,
  "mcps": {
    "home_assistant": {
      "command": "mcp-proxy",
      "args": [
        "--transport",
        "streamablehttp",
        "https://homeassistant.harran.ca/api/mcp"
      ],
      "env": {
        "API_ACCESS_TOKEN": "<Home Assistant long-lived access token>"
      }
    }
  }
}
