# Copy to .env (never committed) and fill in. docker compose reads it from this folder.

# A free static LAN address for Jarvis on Unraid's br0. Open http://JARVIS_IP:8765/.
JARVIS_IP=192.168.111.68
LAN_NETWORK=br0
# Shared secret for every request: header "Authorization: Bearer <token>" or ?token=<token>.
# Generate one with: openssl rand -hex 32
JARVIS_TOKEN=
# Holds config/jarvis/config.json, the memory database and downloaded models.
DATA_DIR=./data

# Home Assistant fast path (optional): HA answers simple home requests in ~0.1 s
# before the LLM is involved. Use a long-lived access token (can be the MCP one).
HA_URL=https://homeassistant.harran.ca
HA_TOKEN=
